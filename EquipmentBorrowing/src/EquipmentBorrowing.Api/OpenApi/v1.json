                }
              }
            }
          },
          "500": {
            "description": "Safe server error or unknown save outcome.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Student": {
        "type": "object",
        "required": [
          "id",
          "studentNumber",
          "fullName",
          "isEligible"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "studentNumber": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "contact": {
            "type": "string",
            "nullable": true
          },
          "isEligible": {
            "type": "boolean"
          }
        }
      },
      "StudentInput": {
        "type": "object",
        "required": [

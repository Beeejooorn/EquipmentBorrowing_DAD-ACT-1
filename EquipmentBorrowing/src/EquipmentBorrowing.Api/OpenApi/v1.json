    "/api/v1/borrowings": {
      "get": {
        "operationId": "listBorrowings",
        "summary": "Search, filter, and sort borrowings",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Trimmed, case-insensitive partial student name, student number, or equipment name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Borrowing status filter.",
            "schema": {
              "type": "string",
              "enum": [
                "All",
                "Active",
                "Returned"
              ],
              "default": "All"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Date field used for ordering.",
            "schema": {
              "type": "string",
              "enum": [
                "borrowedDate",
                "expectedReturnDate"
              ],
              "default": "borrowedDate"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "description": "Sort direction.",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching borrowings, or an empty array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BorrowingDetail"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unsupported filter or sort value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Safe server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createBorrowing",
        "summary": "Borrow one equipment item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BorrowingInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created borrowing. Location identifies the new resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Borrowing"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or expected return date.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Student or equipment not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Eligibility, limit, or availability conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Safe server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

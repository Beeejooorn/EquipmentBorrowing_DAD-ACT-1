<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

	<ScrollViewer>

		<StackPanel Margin="25"
                    Spacing="18">

			<!-- PAGE TITLE -->
			<StackPanel Spacing="4">
				<TextBlock Text="Equipment Catalog"
                           FontSize="26"
                           FontWeight="Bold"/>
				<TextBlock Text="View all equipment or only available items, and borrow one item for a student."
                           FontSize="14"
                           Opacity="0.65"/>
			</StackPanel>

			<!-- FILTER (UC-02) -->
			<StackPanel Orientation="Horizontal" Spacing="15">
				<CheckBox Content="Show available equipment only"
                          IsChecked="{Binding ShowAvailableOnly}"/>
				<Button Content="Refresh"
                        Command="{Binding LoadCommand}"/>
			</StackPanel>

			<!-- EQUIPMENT TABLE (UC-01) -->
			<Border BorderBrush="#DADADA"
                    BorderThickness="1"
                    CornerRadius="8">

				<StackPanel>

					<!-- TABLE HEADER -->
					<Border Background="#F2F2F2"
                            Padding="15">
						<Grid ColumnDefinitions="120,180,*,120">
							<TextBlock Grid.Column="0" Text="Code" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="1" Text="Equipment" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="2" Text="Description" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="3" Text="Availability" FontWeight="Bold" Foreground="Black"/>
						</Grid>
					</Border>

					<!-- LOADING / ERROR / EMPTY STATES -->
					<StackPanel Orientation="Horizontal" Spacing="10" Margin="15"
                                IsVisible="{Binding CatalogState.IsLoading}">
						<ProgressBar IsIndeterminate="True" Width="160"/>
						<TextBlock Text="Loading equipment from the database..."/>
					</StackPanel>

					<Border Classes="Feedback Error" Margin="15"
                            IsVisible="{Binding CatalogState.HasError}">
						<StackPanel Spacing="8">
							<TextBlock Text="{Binding CatalogState.ErrorMessage}"/>
							<Button Content="Retry" Command="{Binding LoadCommand}"/>
						</StackPanel>
					</Border>

					<TextBlock Classes="EmptyState" Margin="15"
                               Text="{Binding CatalogState.EmptyMessage}"
                               IsVisible="{Binding CatalogState.IsEmpty}"/>

					<!-- EQUIPMENT LIST -->
					<ListBox ItemsSource="{Binding EquipmentList}"
                             SelectedItem="{Binding SelectedEquipment}"
                             BorderThickness="0"
                             MaxHeight="320">

						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="domain:Equipment">
								<Grid ColumnDefinitions="120,180,*,120"
                                      Margin="5,4">
									<TextBlock Grid.Column="0" Text="{Binding EquipmentCode}" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
									<TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
									<StackPanel Grid.Column="3" VerticalAlignment="Center">
										<TextBlock Text="Available" Classes="Available" IsVisible="{Binding IsAvailable}"/>
										<TextBlock Text="Borrowed" Classes="Unavailable" IsVisible="{Binding !IsAvailable}"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>

					</ListBox>

				</StackPanel>

			</Border>


			<!-- BORROW FORM (UC-03) -->
			<Border BorderBrush="#DADADA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

				<StackPanel Spacing="12">

					<TextBlock Text="Borrow Equipment"
                               FontSize="20"
                               FontWeight="Bold"/>

					<TextBlock Text="Select a student, one item and the expected return date. Checkout date is today."
                               FontSize="13"
                               Opacity="0.65"
                               Margin="0,0,0,8"/>

					<!-- STUDENT -->
					<TextBlock Text="Student" FontWeight="SemiBold"/>
					<ComboBox ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              HorizontalAlignment="Stretch"
                              MinHeight="38">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="domain:Student">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Text="{Binding StudentNumber}"/>
									<TextBlock Text="{Binding Name}"/>
									<TextBlock Text="(restricted)" Classes="Unavailable" IsVisible="{Binding !IsAllowedToBorrow}"/>
								</StackPanel>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<!-- EQUIPMENT -->
					<TextBlock Text="Equipment" FontWeight="SemiBold" Margin="0,5,0,0"/>
					<ComboBox ItemsSource="{Binding EquipmentList}"
                              SelectedItem="{Binding SelectedEquipment}"
                              HorizontalAlignment="Stretch"
                              MinHeight="38">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="domain:Equipment">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<TextBlock Text="{Binding EquipmentCode}"/>
									<TextBlock Text="{Binding Name}"/>
									<TextBlock Text="(borrowed)" Classes="Unavailable" IsVisible="{Binding !IsAvailable}"/>
								</StackPanel>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<!-- RETURN DATE -->
					<TextBlock Text="Expected Return Date" FontWeight="SemiBold" Margin="0,5,0,0"/>
					<DatePicker SelectedDate="{Binding ExpectedReturnDate}"
                                HorizontalAlignment="Left"
                                Width="280"
                                MinHeight="38"/>

					<!-- BORROW BUTTON -->
					<Button Content="Borrow Equipment"
                            Command="{Binding BorrowCommand}"
                            Classes="Primary"
                            Margin="0,8,0,0"/>

					<!-- RESULT MESSAGE (green = success, orange = rejected, red = error) -->
					<Border Classes="Feedback"
                            Classes.Success="{Binding IsStatusSuccess}"
                            Classes.Rejected="{Binding IsStatusRejected}"
                            Classes.Error="{Binding IsStatusError}"
                            IsVisible="{Binding HasStatus}">
						<TextBlock Text="{Binding StatusMessage}"/>
					</Border>

				</StackPanel>

			</Border>

		</StackPanel>

	</ScrollViewer>

</UserControl>

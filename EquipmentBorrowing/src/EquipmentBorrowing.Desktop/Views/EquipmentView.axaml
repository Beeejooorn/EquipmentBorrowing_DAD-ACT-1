<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="10">

        <TextBlock Grid.Row="0" Text="Equipment" Classes="Heading" />

        <ListBox Grid.Row="1" ItemsSource="{Binding EquipmentList}"
                 SelectedItem="{Binding SelectedEquipment}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Equipment">    
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Name}" Width="150" />
                        <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10">
            <ComboBox ItemsSource="{Binding Students}"
                      SelectedItem="{Binding SelectedStudent}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="domain:Student">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Left" />

            <Button Content="Borrow Equipment" Command="{Binding BorrowCommand}" Classes="Primary" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Classes="StatusMessage" />

    </Grid>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

	<ScrollViewer>

		<StackPanel Margin="25"
                    Spacing="18">

			<!-- PAGE TITLE -->
			<StackPanel Spacing="4">

				<TextBlock Text="Equipment"
                           FontSize="26"
                           FontWeight="Bold"/>

				<TextBlock Text="View available equipment and create a borrowing transaction."
                           FontSize="14"
                           Opacity="0.65"/>

			</StackPanel>


			<!-- EQUIPMENT TABLE -->
			<Border BorderBrush="#DADADA"
                    BorderThickness="1"
                    CornerRadius="8">

				<StackPanel>

					<!-- TABLE HEADER -->
					<Border Background="#F2F2F2"
                            Padding="15">

						<Grid ColumnDefinitions="80,*,160">

							<TextBlock Grid.Column="0"
                                       Text="ID"
                                       FontWeight="Bold"/>

							<TextBlock Grid.Column="1"
                                       Text="Equipment"
                                       FontWeight="Bold"/>

							<TextBlock Grid.Column="2"
                                       Text="Availability"
                                       FontWeight="Bold"/>

						</Grid>

					</Border>


					<!-- EQUIPMENT LIST -->
					<ListBox ItemsSource="{Binding EquipmentList}"
                             SelectedItem="{Binding SelectedEquipment}"
                             BorderThickness="0"
                             MinHeight="180">

						<ListBox.ItemTemplate>

							<DataTemplate x:DataType="domain:Equipment">

								<Grid ColumnDefinitions="80,*,160"
                                      Margin="10,8">

									<TextBlock Grid.Column="0"
                                               Text="{Binding Id}"
                                               VerticalAlignment="Center"/>

									<TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"/>

									<TextBlock Grid.Column="2"
                                               Text="{Binding IsAvailable, StringFormat='Available: {0}'}"
                                               VerticalAlignment="Center"/>

								</Grid>

							</DataTemplate>

						</ListBox.ItemTemplate>

					</ListBox>

				</StackPanel>

			</Border>


			<!-- BORROW FORM -->
			<Border BorderBrush="#DADADA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

				<StackPanel Spacing="12">

					<TextBlock Text="Borrow Equipment"
                               FontSize="20"
                               FontWeight="Bold"/>

					<TextBlock Text="Complete the information below to borrow equipment."
                               FontSize="13"
                               Opacity="0.65"
                               Margin="0,0,0,8"/>


					<!-- STUDENT -->
					<TextBlock Text="Student"
                               FontWeight="SemiBold"/>

					<ComboBox ItemsSource="{Binding Students}"
                              SelectedItem="{Binding SelectedStudent}"
                              HorizontalAlignment="Stretch"
                              MinHeight="38">

						<ComboBox.ItemTemplate>

							<DataTemplate x:DataType="domain:Student">

								<TextBlock Text="{Binding Name}"/>

							</DataTemplate>

						</ComboBox.ItemTemplate>

					</ComboBox>


					<!-- EQUIPMENT -->
					<TextBlock Text="Equipment"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>

					<ComboBox ItemsSource="{Binding EquipmentList}"
                              SelectedItem="{Binding SelectedEquipment}"
                              HorizontalAlignment="Stretch"
                              MinHeight="38">

						<ComboBox.ItemTemplate>

							<DataTemplate x:DataType="domain:Equipment">

								<TextBlock Text="{Binding Name}"/>

							</DataTemplate>

						</ComboBox.ItemTemplate>

					</ComboBox>


					<!-- RETURN DATE -->
					<TextBlock Text="Expected Return Date"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>

					<DatePicker SelectedDate="{Binding ExpectedReturnDate}"
                                HorizontalAlignment="Left"
                                Width="280"
                                MinHeight="38"/>


					<!-- BORROW BUTTON -->
					<Button Content="Borrow Equipment"
                            Command="{Binding BorrowCommand}"
                            HorizontalAlignment="Left"
                            Padding="22,10"
                            Margin="0,8,0,0"
                            FontWeight="SemiBold"/>


					<!-- STATUS MESSAGE -->
					<Border Background="#F5F5F5"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,5,0,0">

						<StackPanel Orientation="Horizontal"
                                    Spacing="8">

							<TextBlock Text="Status:"
                                       FontWeight="Bold"/>

							<TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"/>

						</StackPanel>

					</Border>

				</StackPanel>

			</Border>

		</StackPanel>

	</ScrollViewer>

</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:models="using:EquipmentBorrowing.Application.Models"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

	<ScrollViewer>

		<StackPanel Margin="25" Spacing="15">

			<StackPanel Spacing="4">
				<TextBlock Text="Active Borrowings" FontSize="26" FontWeight="Bold"/>
				<TextBlock Text="Items that are currently borrowed. Select one and return it."
                           FontSize="14" Opacity="0.65"/>
			</StackPanel>

			<Button Content="Refresh" Command="{Binding LoadCommand}"/>

			<Border BorderBrush="#DADADA" BorderThickness="1" CornerRadius="8">
				<StackPanel>

					<Border Background="#F2F2F2" Padding="15">
						<Grid ColumnDefinitions="60,110,170,110,170,110,110">
							<TextBlock Grid.Column="0" Text="#" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="1" Text="Student No." FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="2" Text="Student" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="3" Text="Code" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="4" Text="Equipment" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="5" Text="Checkout" FontWeight="Bold" Foreground="Black"/>
							<TextBlock Grid.Column="6" Text="Due" FontWeight="Bold" Foreground="Black"/>
						</Grid>
					</Border>

					<StackPanel Orientation="Horizontal" Spacing="10" Margin="15"
                                IsVisible="{Binding ListState.IsLoading}">
						<ProgressBar IsIndeterminate="True" Width="160"/>
						<TextBlock Text="Loading active borrowings..."/>
					</StackPanel>

					<Border Classes="Feedback Error" Margin="15" IsVisible="{Binding ListState.HasError}">
						<StackPanel Spacing="8">
							<TextBlock Text="{Binding ListState.ErrorMessage}"/>
							<Button Content="Retry" Command="{Binding LoadCommand}"/>
						</StackPanel>
					</Border>

					<TextBlock Classes="EmptyState" Margin="15"
                               Text="{Binding ListState.EmptyMessage}"
                               IsVisible="{Binding ListState.IsEmpty}"/>

					<ListBox ItemsSource="{Binding ActiveBorrowings}"
                             SelectedItem="{Binding SelectedBorrowing}"
                             BorderThickness="0"
                             MaxHeight="380">
						<ListBox.ItemTemplate>
							<DataTemplate x:DataType="models:BorrowingRecord">
								<Grid ColumnDefinitions="60,110,170,110,170,110,110" Margin="5,4">
									<TextBlock Grid.Column="0" Text="{Binding BorrowingId}"/>
									<TextBlock Grid.Column="1" Text="{Binding StudentNumber}"/>
									<TextBlock Grid.Column="2" Text="{Binding StudentName}"/>
									<TextBlock Grid.Column="3" Text="{Binding EquipmentCode}"/>
									<TextBlock Grid.Column="4" Text="{Binding EquipmentName}"/>
									<TextBlock Grid.Column="5" Text="{Binding DateBorrowedText}"/>
									<TextBlock Grid.Column="6" Text="{Binding ExpectedReturnDateText}"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

				</StackPanel>
			</Border>

			<Button Content="Return Selected Equipment..." Command="{Binding AskReturnCommand}"
                    Classes="Primary"/>

			<!-- CONFIRMATION PANEL -->
			<Border Classes="Feedback" IsVisible="{Binding IsConfirmingReturn}">
				<StackPanel Spacing="10">
					<TextBlock Text="{Binding ConfirmText}" FontWeight="SemiBold"/>
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Yes, return it" Command="{Binding ConfirmReturnCommand}" Classes="Primary"/>
						<Button Content="Cancel" Command="{Binding CancelReturnCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Classes="Feedback"
                    Classes.Success="{Binding IsStatusSuccess}"
                    Classes.Rejected="{Binding IsStatusRejected}"
                    Classes.Error="{Binding IsStatusError}"
                    IsVisible="{Binding HasStatus}">
				<TextBlock Text="{Binding StatusMessage}"/>
			</Border>

		</StackPanel>

	</ScrollViewer>

</UserControl>

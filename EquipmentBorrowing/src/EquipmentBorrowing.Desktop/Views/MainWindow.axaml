<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Campus Equipment Borrowing System">

	<Grid ColumnDefinitions="200,*">

		<StackPanel Grid.Column="0" Spacing="10" Margin="10">
			<TextBlock Text="Menu" Classes="Heading" />
			<Button Content="Equipment" Command="{Binding ShowEquipmentCommand}"
                    Classes="NavButton" HorizontalAlignment="Stretch" />
			<Button Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}"
                    Classes="NavButton" HorizontalAlignment="Stretch" />
		</StackPanel>

		<ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="10" />

	</Grid>

</Window>